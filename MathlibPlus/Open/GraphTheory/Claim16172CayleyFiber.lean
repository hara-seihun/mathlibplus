import Mathlib
import MathlibPlus.Open.ResearchFormalization.R1022

namespace MathlibPlus.Open.GraphTheory

/-- The group generated by the two right-regular copies, with the
f⁻¹ R(G) f convention. -/
def schurianGroup16172 {G : Type*} [Group G]
    (f : Equiv.Perm G) : Subgroup (Equiv.Perm G) :=
  Subgroup.closure
    (Set.range (fun g : G => Equiv.mulRight g) ∪
      Set.range (fun g : G => f⁻¹ * Equiv.mulRight g * f))

/-- An identity-stabilizer orbit in the Schurian group. -/
def schurianBasicSet16172 {G : Type*} [Group G]
    (f : Equiv.Perm G) (x : G) : Set G :=
  {y | ∃ k : schurianGroup16172 f,
    k.1 (1 : G) = 1 ∧ k.1 x = y}

/-- The A_f-subset condition, expressed as a union of Schurian basic sets. -/
def isAfSubset16172 {G : Type*} [Group G]
    (f : Equiv.Perm G) (S : Set G) : Prop :=
  ∀ x : G,
    schurianBasicSet16172 f x ⊆ S ∨
      ∀ y ∈ schurianBasicSet16172 f x, y ∉ S

/-- The relative-derivative subgroup from Claim 16168. -/
def derivativeGroup16172 {G : Type*} [Group G]
    (f : Equiv.Perm G) : Subgroup (Equiv.Perm G) :=
  Subgroup.closure
    (Set.range (MathlibPlus.Open.ResearchFormalization.R1022.relativeDerivative f))

/-- Union of relative-derivative orbits. -/
def derivativeOrbitUnion16172 {G : Type*} [Group G]
    (f : Equiv.Perm G) (S : Set G) : Prop :=
  ∀ d : derivativeGroup16172 f,
    Set.image d.1 S = S

/-- The ordinary undirected Cayley graph on a multiplicative group. -/
def ordinaryCayleyGraph16172 {G : Type*} [Group G]
    (S : Set G) : SimpleGraph G :=
  SimpleGraph.mulCayley S

/-- A permutation is an automorphism of a simple graph. -/
def graphAutomorphism16172 {Ω : Type*}
    (Γ : SimpleGraph Ω) (g : Equiv.Perm Ω) : Prop :=
  ∀ x y : Ω, Γ.Adj x y ↔ Γ.Adj (g x) (g y)

/-- Regularity of a permutation subgroup. -/
def regularPermutationGroup16172 {Ω : Type*}
    (P : Subgroup (Equiv.Perm Ω)) : Prop :=
  ∀ x y : Ω, ∃! p : P, p.1 x = y

/-- The subgroup generated by the marked regular pair. -/
def generatedPairGroup16172 {Ω : Type*}
    (P Q : Subgroup (Equiv.Perm Ω)) : Subgroup (Equiv.Perm Ω) :=
  Subgroup.closure ((P : Set (Equiv.Perm Ω)) ∪ (Q : Set (Equiv.Perm Ω)))

/-- A selected symmetric fusion is invariant under the group generated by the
marked regular pair. -/
def selectedSymmetricFusion16172 {Ω : Type*}
    (Γ : SimpleGraph Ω) (P Q : Subgroup (Equiv.Perm Ω)) : Prop :=
  ∀ k : generatedPairGroup16172 P Q, graphAutomorphism16172 Γ k.1

/-- The connection set read from a marked regular action at its base point. -/
def markedConnectionSet16172 {G Ω : Type*} [Group G]
    {P : Subgroup (Equiv.Perm Ω)}
    (Γ : SimpleGraph Ω) (o : Ω) (m : G ≃* P) : Set G :=
  {g | g ≠ 1 ∧ Γ.Adj o ((m g : Equiv.Perm Ω) o)}

/-- An ordinary Cayley presentation of a graph in the fiber of Cay(G,S). -/
def ordinaryCayleyPresentation16172
    {G Ω : Type*} [Group G]
    (S : Set G) (Γ : SimpleGraph Ω) (o : Ω)
    (P Q : Subgroup (Equiv.Perm Ω))
    (mP : G ≃* P) (mQ : G ≃* Q) : Prop :=
  regularPermutationGroup16172 P ∧
    regularPermutationGroup16172 Q ∧
    selectedSymmetricFusion16172 Γ P Q ∧
    Nonempty (Γ ≃g ordinaryCayleyGraph16172 S) ∧
    markedConnectionSet16172 Γ o mP = S ∧
    (∀ g, g ∈ markedConnectionSet16172 Γ o mQ ↔
      g⁻¹ ∈ markedConnectionSet16172 Γ o mQ)

/-- Claim 16172: the complete ordinary Cayley-representation fiber is exactly
obtained from normalized derivative-orbit-stable permutations, up to group
automorphisms, and every such image occurs. -/
def complete_cayley_representation_fiber : Prop :=
  ∀ (G : Type*) [Fintype G] [Group G] (S : Set G),
    S ⊆ ({1} : Set G)ᶜ →
      (∀ g, g ∈ S ↔ g⁻¹ ∈ S) →
        (∀ (Ω : Type*) (_ : Finite Ω) (Γ : SimpleGraph Ω) (o : Ω)
            (P Q : Subgroup (Equiv.Perm Ω))
            (mP : G ≃* P) (mQ : G ≃* Q),
          ordinaryCayleyPresentation16172 S Γ o P Q mP mQ →
            ∃ f : Equiv.Perm G,
              f 1 = 1 ∧
              derivativeOrbitUnion16172 f S ∧
              isAfSubset16172 f S ∧
              ∃ α : G ≃* G,
                markedConnectionSet16172 Γ o mQ = α '' (f '' S)) ∧
        (∀ f : Equiv.Perm G,
          f 1 = 1 →
            (derivativeOrbitUnion16172 f S ↔ isAfSubset16172 f S) ∧
            (derivativeOrbitUnion16172 f S →
              ∃ (Ω : Type*), Finite Ω ∧ ∃ (Γ : SimpleGraph Ω) (o : Ω)
                (P Q : Subgroup (Equiv.Perm Ω))
                (mP : G ≃* P) (mQ : G ≃* Q),
                ordinaryCayleyPresentation16172 S Γ o P Q mP mQ ∧
                  markedConnectionSet16172 Γ o mQ = f '' S))

end MathlibPlus.Open.GraphTheory
