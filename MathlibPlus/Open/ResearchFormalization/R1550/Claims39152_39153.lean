import Mathlib

namespace MathlibPlus.Open.ResearchFormalization.R1550

abbrev F3 := ZMod 3
abbrev RepairPlane := Fin 2 → F3
abbrev RepairBase := Fin 4 → F3
abbrev RepairProfile := RepairBase → RepairPlane
abbrev ScalarRepairProfile := RepairBase → F3

/-- The line generated by the specified nonzero section value. -/
def repairLine (w : RepairPlane) : Submodule F3 RepairPlane :=
  Submodule.span F3 ({w} : Set RepairPlane)

/-- Normalization at the base origin used by the repair system. -/
def normalizedRepairProfile (p : RepairProfile) : Prop :=
  p 0 = 0

/-- A functional is active precisely when it is nonzero on the line. -/
def activeRepairFunctional
    (W : Submodule F3 RepairPlane)
    (lam : RepairPlane →ₗ[F3] F3) : Prop :=
  ∃ v : RepairPlane, v ∈ W ∧ lam v ≠ 0

/-- A functional is an annihilator precisely when it vanishes on the line. -/
def annihilatorRepairFunctional
    (W : Submodule F3 RepairPlane)
    (lam : RepairPlane →ₗ[F3] F3) : Prop :=
  ∀ v : RepairPlane, v ∈ W → lam v = 0

/-- The line-supported normalized affine repair-torsor predicate. -/
def lineSupportedNormalizedAffineRepairTorsor_claim39152
    (R : AffineSubspace F3 RepairProfile)
    (w : RepairPlane)
    (W : Submodule F3 RepairPlane) : Prop :=
  Nonempty R ∧
    w ≠ 0 ∧
    W = repairLine w ∧
    W ≠ ⊤ ∧
    (∀ p : RepairProfile, p ∈ R → normalizedRepairProfile p) ∧
    (∀ p q : RepairProfile, p ∈ R → q ∈ R →
      ∀ b : RepairBase, p b - q b ∈ W)

/-- A family of independently defined full scalar repair carriers.  The
    family is supplied by the scalar repair systems, rather than being
    defined as an image of the plane-valued carrier. -/
abbrev ScalarRepairTorsorFamily :=
  (RepairPlane →ₗ[F3] F3) →
    AffineSubspace F3 ScalarRepairProfile

/-- Scalar projection of a plane-valued correction profile. -/
def scalarRepairProjection
    (lam : RepairPlane →ₗ[F3] F3)
    (p : RepairProfile) : ScalarRepairProfile :=
  fun b => lam (p b)

/-- The stated onto hypothesis for every active scalar repair carrier. -/
def scalarRepairProjectionsOnto
    (R : AffineSubspace F3 RepairProfile)
    (W : Submodule F3 RepairPlane)
    (scalarTorsors : ScalarRepairTorsorFamily) : Prop :=
  ∀ (nu : RepairPlane →ₗ[F3] F3),
    activeRepairFunctional W nu →
      ∀ u : ScalarRepairProfile,
        u ∈ scalarTorsors nu ↔
          ∃ p : RepairProfile, p ∈ R ∧ scalarRepairProjection nu p = u

/-- The simultaneous image of two scalar projections of the actual
    plane-valued repair carrier. -/
def jointScalarRepairImage
    (R : AffineSubspace F3 RepairProfile)
    (lam mu : RepairPlane →ₗ[F3] F3) :
    Set (ScalarRepairProfile × ScalarRepairProfile) :=
  Set.image
    (fun p : RepairProfile =>
      (scalarRepairProjection lam p, scalarRepairProjection mu p))
    (R : Set RepairProfile)

/-- Direction span of an affine image, written without replacing that image
    by an unrelated affine subspace. -/
def affineDifferenceSpan
    {V : Type*} [AddCommGroup V] [Module F3 V]
    (S : Set V) : Submodule F3 V :=
  Submodule.span F3
    {v | ∃ x y, x ∈ S ∧ y ∈ S ∧ v = x - y}

/-- The affine graph forced by a multiplier on two actual scalar repair
    carriers, based at a plane-valued repair p0. -/
def diagonalScalarRepairGraph
    (scalarTorsors : ScalarRepairTorsorFamily)
    (lam mu : RepairPlane →ₗ[F3] F3)
    (p0 : RepairProfile)
    (multiplier : F3) :
    Set (ScalarRepairProfile × ScalarRepairProfile) :=
  {z |
    z.1 ∈ scalarTorsors lam ∧
      z.2 ∈ scalarTorsors mu ∧
      z.2 - scalarRepairProjection mu p0 =
        multiplier • (z.1 - scalarRepairProjection lam p0)}

/-- Independence of two scalar functionals. -/
def independentRepairFunctionals
    (lam mu : RepairPlane →ₗ[F3] F3) : Prop :=
  LinearIndependent F3 ![lam, mu]

/-- Claim 39153: active independent scalar projections of a line-supported
normalized repair torsor have the exact diagonal image and dimension deficit.
The scalar carriers in `scalarTorsors` are the full scalar repair torsors;
the onto premise is separate from their carrier definitions. -/
def diagonalImageLemma_claim39153
    (R : AffineSubspace F3 RepairProfile)
    (w : RepairPlane)
    (W : Submodule F3 RepairPlane)
    (scalarTorsors : ScalarRepairTorsorFamily)
    (lam mu : RepairPlane →ₗ[F3] F3)
    (d : ℕ) : Prop :=
  (lineSupportedNormalizedAffineRepairTorsor_claim39152 R w W ∧
    0 < d ∧
    Module.finrank F3 R.direction = d ∧
    scalarRepairProjectionsOnto R W scalarTorsors ∧
    activeRepairFunctional W lam ∧
    activeRepairFunctional W mu ∧
    independentRepairFunctionals lam mu) →
    (∀ p q : RepairProfile, p ∈ R → q ∈ R →
      ∀ b : RepairBase,
        mu (p b - q b) =
          (mu w / lam w) * lam (p b - q b)) ∧
    (∃ p0 : RepairProfile, p0 ∈ R ∧
      jointScalarRepairImage R lam mu =
        diagonalScalarRepairGraph scalarTorsors lam mu p0
          (mu w / lam w) ∧
      Module.finrank F3
          (affineDifferenceSpan (jointScalarRepairImage R lam mu)) = d ∧
      Module.finrank F3 (scalarTorsors lam).direction = d ∧
      Module.finrank F3 (scalarTorsors mu).direction = d ∧
      Module.finrank F3
          ((scalarTorsors lam).direction × (scalarTorsors mu).direction) =
        2 * d ∧
      Module.finrank F3
          ((scalarTorsors lam).direction × (scalarTorsors mu).direction) -
          Module.finrank F3
            (affineDifferenceSpan (jointScalarRepairImage R lam mu)) = d ∧
      (mu w / lam w) ≠ 0) ∧
    ¬ (∀ u : ScalarRepairProfile, ∀ v : ScalarRepairProfile,
      u ∈ scalarTorsors lam →
      v ∈ scalarTorsors mu →
      (u, v) ∈ jointScalarRepairImage R lam mu)

end MathlibPlus.Open.ResearchFormalization.R1550
