open scoped BigOperators

/-- The finite complementary form of the positive-offset equation. -/
def complementaryFiniteForm : Prop :=
  ∀ (n m : ℕ) (D : Finset ℕ) (hD : D.Nonempty),
    (∀ d ∈ D, 0 < d) →
    m ∈ D →
    D.max' hD = m →
    ((n : ℚ) =
        D.sum (fun d => ((n + d : ℕ) : ℚ) / (2 : ℚ) ^ d)) ↔
      ((2 : ℚ) ^ (m + 1) =
        (n + m + 2 : ℕ) +
          ((Finset.Icc 1 m).filter (fun d => d ∉ D)).sum
            (fun d => ((n + d : ℕ) : ℚ) * (2 : ℚ) ^ (m - d)))

/-- The residual sequence generated by the greedy branch rule, indexed from the
initial residual at offset zero. -/
def greedyResidualFrom (n : ℕ) : ℕ → ℤ
  | 0 => (n : ℤ)
  | j + 1 =>
      let r := greedyResidualFrom n j
      let k := n + j
      if 2 * r ≥ ((k + 1 : ℕ) : ℤ) then
        2 * r - ((k + 1 : ℕ) : ℤ)
      else
        2 * r

/-- The residual at the original index k (indices before n are immaterial). -/
def greedyResidual (n k : ℕ) : ℤ :=
  if n ≤ k then greedyResidualFrom n (k - n) else 0

/-- The digit selected by the greedy residual branch at offset j. -/
def greedyDigit (n j : ℕ) : Fin 2 :=
  if 2 * greedyResidualFrom n j ≥ ((n + j + 1 : ℕ) : ℤ) then 1 else 0

/-- Finiteness of the greedy representation, expressed as eventual vanishing of
its concrete branch digits. -/
def greedyRepresentationFinite (n : ℕ) : Prop :=
  ∃ J : ℕ, ∀ j : ℕ, J ≤ j → greedyDigit n j = 0

/-- The greedy residual bounds and the finite-representation criterion. -/
def greedyResidualCalculus : Prop :=
  ∀ n : ℕ,
    greedyResidual n n = (n : ℤ) ∧
    (∀ k : ℕ, n ≤ k →
      greedyResidual n (k + 1) =
        if 2 * greedyResidual n k ≥ ((k + 1 : ℕ) : ℤ) then
          2 * greedyResidual n k - ((k + 1 : ℕ) : ℤ)
        else
          2 * greedyResidual n k) ∧
    (∀ k : ℕ, n ≤ k →
      0 ≤ greedyResidual n k ∧
        greedyResidual n k ≤ ((k + 1 : ℕ) : ℤ)) ∧
    (greedyRepresentationFinite n ↔
      ∃ k : ℕ, n ≤ k ∧ greedyResidual n k = 0)

/-- The binary value of a digit stream whose positions start at one. -/
noncomputable def binaryValue (d : ℕ → Fin 2) : ℝ :=
  ∑' j : ℕ, ((d (j + 1)).val : ℝ) / (2 : ℝ) ^ (j + 1)

/-- The first weighted moment of the same binary digit stream. -/
noncomputable def binaryFirstMoment (d : ℕ → Fin 2) : ℝ :=
  ∑' j : ℕ,
    ((j + 1 : ℕ) : ℝ) * ((d (j + 1)).val : ℝ) / (2 : ℝ) ^ (j + 1)

/-- The sawtooth series used in the binary identity. -/
noncomputable def binarySawtooth (y : ℝ) : ℝ :=
  ∑' i : ℕ, Int.fract ((2 : ℝ) ^ i * y) / (2 : ℝ) ^ i

/-- A stream has the terminating/all-ones ambiguity when it has a constant binary tail. -/
def terminatingOrAllOnesTail (d : ℕ → Fin 2) : Prop :=
  ∃ p : ℕ, 1 ≤ p ∧
    ((∀ j : ℕ, p ≤ j → (d j).val = 0) ∨
      (∀ j : ℕ, p ≤ j → (d j).val = 1))

/-- The binary sawtooth identity away from the terminating/all-ones ambiguity. -/
def binarySawtoothIdentity : Prop :=
  ∀ (d : ℕ → Fin 2) (y : ℝ),
    y = binaryValue d →
    ¬ terminatingOrAllOnesTail d →
    Summable (fun j : ℕ =>
      ((j + 1 : ℕ) : ℝ) * ((d (j + 1)).val : ℝ) / (2 : ℝ) ^ (j + 1)) ∧
    Summable (fun i : ℕ =>
      Int.fract ((2 : ℝ) ^ i * y) / (2 : ℝ) ^ i) ∧
    binaryFirstMoment d = binarySawtooth y

/-- The two binary expansions at a dyadic ambiguity have a fixed moment gap. -/
def dyadicAmbiguityMomentGap : Prop :=
  ∀ (p : ℕ) (d₀ d₁ : ℕ → Fin 2),
    1 ≤ p →
    (∀ j : ℕ, j < p → d₀ j = d₁ j) →
    d₀ p = 1 →
    d₁ p = 0 →
    (∀ j : ℕ, p < j → d₀ j = 0) →
    (∀ j : ℕ, p < j → d₁ j = 1) →
    binaryValue d₀ = binaryValue d₁ ∧
    binaryFirstMoment d₁ - binaryFirstMoment d₀ =
      2 / (2 : ℝ) ^ p ∧
    binaryFirstMoment d₁ ≠ binaryFirstMoment d₀

end MathlibPlus.Open.ResearchFormalizationBatch019ffee2
